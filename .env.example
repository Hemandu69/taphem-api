# ==============================================================================
# Taphem API - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your local development environment.
# Never commit real .env files containing environment-specific values or secrets.
# ==============================================================================

# Port the HTTP server will listen on
PORT=4000

# Application environment (development | production | test)
NODE_ENV=development

# Comma-separated list of allowed CORS origins for the frontend client(s)
# Example: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=

# Optional public CDN base URL for manga assets
# Example: https://cdn-beta.example.com
MANGA_CDN_BASE_URL=
