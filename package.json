{
  "name": "taphem-api",
  "version": "1.0.0",
  "description": "Backend API for Taphem manga discovery and reading platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/**/*.test.ts",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts up",
    "db:migrate:down": "tsx src/infrastructure/database/migrate.ts down",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "source:verify": "tsx src/modules/ingestion/scripts/verify-source.ts",
    "source:ingest": "tsx src/modules/ingestion/scripts/ingest-source.ts",
    "source:search": "tsx src/modules/ingestion/scripts/search-source.ts"
  },
  "keywords": [
    "taphem",
    "api",
    "manga",
    "express",
    "typescript",
    "postgresql",
    "mangadex"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "eslint": "^9.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
